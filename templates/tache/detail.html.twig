{% extends 'base.html.twig' %}

{% block title %}{{ tache.titre }}{% endblock %}

{% block body %}
    <div class="card p-4 shadow-sm">
        <h1 class="mb-3">{{ tache.titre }}</h1>
        <p class="text-muted">
            Créée le : {{ tache.dateCreation|date('d/m/Y à H:i') }}
        </p>
        <hr>
        <p class="lead">
            {{ tache.description }}
        </p>
        <p>
            <strong>Statut : </strong>
            {% if tache.terminee %}
                <span class="badge bg-success">Terminée</span>
            {% else %}
                <span class="badge bg-warning text-dark">En cours</span>
            {% endif %}
        </p>
        <div class="mt-4">
            <a href="{{ path('app_taches') }}" class="btn btn-secondary">Retour à la liste</a>
        </div>
    </div>
{% endblock %}